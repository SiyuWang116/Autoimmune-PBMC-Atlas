# Fig. 4H: SingleR assignments, not trajectory-derived transition probabilities; pie uses scores >0.3.
fig4H <- function(sobj) {
  mye <- prepare_myeloid(sobj)
  run_panel({
    library(SingleR)
    library(Seurat)
    library(ggplot2)
    library(pheatmap)
    ref_sub <- subset(mye, celltype %in% c("Classical Mono_HLA-DR", "Non-classical Mono"))
    ref_counts <- GetAssayData(ref_sub, layer = "data")
    ref_labels <- ref_sub$celltype
    query_sub <- subset(mye, celltype == "Mono_C1QC")
    query_counts <- GetAssayData(query_sub, layer = "data")
    pred_mono <- SingleR(test = query_counts,
                         ref = ref_counts,
                         labels = ref_labels,
                         genes = "de",
                         de.n = 10)
    query_max_scores <- apply(pred_mono$scores, 1, max)
    keep_indices <- query_max_scores > 0.3
    if (!any(keep_indices)) stop("No SingleR predictions exceed the 0.3 score threshold.")
    final_predictions <- pred_mono$labels[keep_indices]
    print(table(final_predictions))
    print(prop.table(table(final_predictions)))
    plot_data <- as.data.frame(prop.table(table(final_predictions)))
    colnames(plot_data) <- c("Source", "Fraction")
    plot_data <- plot_data %>%
      mutate(
        Percentage = paste0(round(Fraction * 100, 2), "%"),
        label_pos = cumsum(Fraction) - (Fraction / 2)
      )
    ggplot(plot_data, aes(x = "", y = Fraction, fill = Source)) +
      geom_bar(stat = "identity", linewidth = 0.8, color = "white") +
      coord_polar(theta = "y", start = 0) +
      scale_fill_manual(values = c("Classical Mono_HLA-DR" = "#d3ecd5", "Non-classical Mono" = "#abc9ea")) +
      geom_text(aes(y = label_pos, label = Percentage), color = "#333333", size = 5, fontface = "bold") +
      theme_void() +
      theme(
        plot.title = element_text(hjust = 0.5, size = 14, face = "bold", vjust = 2),
        legend.title = element_blank(),
        legend.text = element_text(size = 11, face = "plain"),
        plot.margin = margin(1, 1, 1, 1, "cm")
      ) +
      labs(title = "Predicted Origin of Mono_C1QC Cells")
    ggsave(file.path(out_dir, 'Fig4H_reference_assignments.pdf'),width = 6, height = 5)
  })
# I-J retain all assignments, matching the original differential analysis.
  query_sub$reference_label <- pred_mono$labels[match(colnames(query_sub), rownames(pred_mono))]
  write.csv(data.frame(Cell = rownames(pred_mono), Label = pred_mono$labels,
                      MaxScore = query_max_scores, RetainedForPie = keep_indices),
            file.path(out_dir, "Fig4H_SingleR_predictions.csv"), row.names = FALSE)
  invisible(list(query = query_sub, predictions = pred_mono, fractions = plot_data))
}


# Fig. 4I: GO of genes upregulated in NCM-associated versus HLA-DR CM-associated C1QC cells.
fig4I <- function(query) {
  library(clusterProfiler)
  library(org.Hs.eg.db)
  sobj <- query
  DefaultAssay(sobj) <- "RNA"
  run_panel({
    what <- FindMarkers(sobj,group.by = 'reference_label',ident.1 = 'Non-classical Mono',ident.2 = 'Classical Mono_HLA-DR')
    up <- what[what$avg_log2FC > 0.25 & what$p_val_adj < 0.05,]
    up_go_enrich <- enrichGO(gene = rownames(up),
                          OrgDb = org.Hs.eg.db,
                          keyType = "SYMBOL",
                          ont = "BP",
                          pAdjustMethod = "BH",
                          pvalueCutoff = 0.05)
    down <- what[what$avg_log2FC < -0.25 & what$p_val_adj < 0.05,]
    down_go_enrich <- enrichGO(gene = rownames(down),
                          OrgDb = org.Hs.eg.db,
                          keyType = "SYMBOL",
                          ont = "BP",
                          pAdjustMethod = "BH",
                          pvalueCutoff = 0.05)
    df <- as.data.frame(up_go_enrich)
    df_select <- df[df$Description %in% c('tumor necrosis factor production',
                                          'leukocyte mediated cytotoxicity',
                                          'inflammatory response to antigenic stimulus',
                                          'response to type II interferon'),]
    df_top <- df_select %>%
      arrange(p.adjust) %>%
      dplyr::slice(1:8) %>%
      mutate(Description = fct_reorder(Description, -log10(p.adjust)))
    ggplot(df_top, aes(x = Description, y = -log10(p.adjust))) +
      geom_segment(aes(xend = Description, yend = 0), color = "gray70", size = 0.7) +
      geom_point(size =5,fill='#719fd8',color='#719fd8',stroke=0,show.legend = FALSE, alpha = 1) +
      geom_text(aes(label = Count), color = "white", size = 2) +
      coord_flip() +
      theme_minimal() +
      labs(title = "C1QC_Mono Upregulated Pathways",
           x = NULL,
           y = expression(-log[10](adj~P~value))) +
      theme(panel.grid.major.y = element_blank(),
            panel.grid.minor = element_blank(),
            panel.grid.major= element_blank(),
            axis.ticks = element_line(color = 'black'),
            axis.ticks.length = unit(2.5,'pt'),
            axis.line = element_line(colour = 'black'))
    ggsave(file.path(out_dir, 'Fig4I_reference_subset_GO.pdf'),width = 6,height = 2)
  })

}


