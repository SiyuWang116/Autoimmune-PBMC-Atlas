# Fig. 4 and Supplementary Fig. 5: C1QC-positive monocytes.
# Input: normalized myeloid Seurat object with RNA counts/data, UMAP,
# and metadata Sample, majordisease, celltype. Each function uses a local copy.
# Source this file, then call the functions listed at the end.
# NicheNet targets: C1QC+ monocyte markers with adjusted P <0.05 and avg_log2FC >0.5.
# Bulk ssGSEA: top 10 C1QC+ monocyte DEGs; heatmap: selected C1QC+ monocyte DEGs.

library(Seurat)
library(tidyverse)
library(ggpubr)
library(patchwork)
library(ComplexHeatmap)
library(grid)

out_dir <- "fig4_c1qc"
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

prepare_myeloid <- function(sobj) {
  DefaultAssay(sobj) <- "RNA"
  labels <- as.character(sobj$celltype)
  labels[labels %in% c("Intermediate Mono", "Inter-Mono")] <- "Classical Mono_HLA-DR"
  labels[labels == "Macrophage_C1QC"] <- "Mono_C1QC"
  sobj$celltype <- labels
  disease <- as.character(sobj$majordisease)
  disease[disease %in% c("Behçet’s disease", "Behçet's disease")] <- "BD"
  sobj$majordisease <- disease
  sobj
}
mono_types <- c("Mono_C1QC", "Non-classical Mono", "Classical Mono_HLA-DR",
                "Classical Mono_IFN-response", "Classical Mono_NR4A2", "Classical Mono")
subtypelist <- c("Non-classical Mono" = "#F8CBA6", pDC = "#B7EA63", cDC2 = "#d5c9db",
  "Classical Mono" = "#FADFA1", Mono_C1QC = "#0D747A", "Classical Mono_NR4A2" = "#DFF4F3",
  "Classical Mono_IFN-response" = "#46855E", "Classical Mono_HLA-DR" = "#b8bbe7",
  Neutrophlis = "#F99B36", Neutrophils = "#F99B36", cDC1 = "#95D4FF")

# Print visible plot expressions inside functions, including open PDF devices.
run_panel <- function(code) {
  expr <- substitute(code)
  env <- parent.frame()
  expressions <- if (is.call(expr) && identical(expr[[1]], as.name("{"))) as.list(expr)[-1] else list(expr)
  for (e in expressions) {
    result <- withVisible(eval(e, envir = env))
    if (result$visible && inherits(result$value, c("ggplot", "patchwork", "Heatmap", "HeatmapList")))
      print(result$value)
  }
  invisible(NULL)
}


# Fig. 4A: sample-level proportions; denominator = all myeloid cells, >200 per sample.
fig4A <- function(sobj) {
  sobj <- prepare_myeloid(sobj)
  run_panel({
    meta <- sobj@meta.data
    df <- as.data.frame(table(sobj$Sample))
    valid_samples <- as.character(df[df$Freq > 200,]$Var1)
    meta <- meta[meta$Sample %in% valid_samples,]
    qc_counts <- meta %>%
      group_by(sample = meta$Sample, disease = meta$majordisease) %>%
      summarise(n_C1QC = sum(celltype == "Mono_C1QC"),
                total = n(), .groups = "drop") %>%
      mutate(prop_C1QC = n_C1QC / total)
    qc_filtered <- qc_counts[qc_counts$disease %in% c('Healthy','BD','KD','MIS-C'),]
    qc_filtered <- qc_filtered[qc_filtered$disease != 'Febrile control+URI',]
    qc_filtered$disease <- factor(qc_filtered$disease,levels = c('Healthy','BD','MIS-C','KD'))
    pdf(file.path(out_dir, 'Fig4A_C1QC_proportions.pdf'),width = 3,height = 5)
    ggplot(qc_filtered,aes(x = disease, y = prop_C1QC)) +
      geom_boxplot(color = '#0D747A',size = 0.6,alpha = 0.2,outlier.shape = NA) +
      geom_jitter(color = '#0D747A',width = 0.2,size=1) +
      theme_bw() +
      ylab("Proportion of C1QC+ monocytes among myeloid cells") +
      xlab("Disease group") +
      ggtitle("") +
      theme_classic() +
      stat_compare_means(label = 'p.format',
                         method = 'wilcox.test',
                         ref.group = 'Healthy',
                         size = 3.5) +
      theme(
        panel.background = element_blank(),
        panel.grid.major = element_blank(),
        panel.grid.minor = element_blank(),
        strip.background = element_blank(),
        axis.text.x = element_text(angle = 45, hjust = 1,size=11),
        axis.text.y = element_text(size=11),
        legend.position = "none"
      )
    dev.off()
  })

}


# Fig. 4B: one shared UMAP; retain all input cells and the original coordinates.
# Healthy: green; KD/BD/MIS-C: purple; other diseases: light gray.
# Seed 123 shuffles drawing order only; no cells are removed or downsampled.
fig4B <- function(sobj) {
  sobj <- prepare_myeloid(sobj)
  run_panel({
    library(Seurat)
    library(ggplot2)
    library(dplyr)
    meta <- sobj@meta.data
    meta$plot_group <- "Other diseases"
    meta$plot_group[
      meta$majordisease == "Healthy"
    ] <- "Healthy"
    target_diseases <- c(
      "KD",
      "BD",
      "MIS-C"
    )
    meta$plot_group[
      meta$majordisease %in% target_diseases
    ] <- "KD/BD/MIS-C"
    sobj@meta.data <- meta
    umap_df <- FetchData(
      sobj,
      vars=c(
        "umap_1",
        "umap_2",
        "plot_group"
      )
    )
    umap_df$plot_group <- factor(
      umap_df$plot_group,
      levels=c(
        "Other diseases",
        "Healthy",
        "KD/BD/MIS-C"
      )
    )
    set.seed(123)
    umap_df <- umap_df[
      sample(nrow(umap_df)),
    ]
    pdf(
      file.path(out_dir, 'Fig4B_disease_UMAP.pdf'),
      width=8,
      height=5
    )
    ggplot(
      umap_df,
      aes(
        umap_1,
        umap_2,
        color=plot_group
      )
    )+
      geom_point(
        aes(
          alpha=plot_group,
          size=plot_group
        )
      )+
      scale_color_manual(
        values=c(
          "Other diseases"="#D9D9D9",
          "Healthy"="#1b9e77",
          "KD/BD/MIS-C"="#5b5ea6"
        )
      )+
      scale_alpha_manual(
        values=c(
          "Other diseases"=0.15,
          "Healthy"=0.8,
          "KD/BD/MIS-C"=0.8
        )
      )+
      scale_size_manual(
        values=c(
          "Other diseases"=0.15,
          "Healthy"=0.15,
          "KD/BD/MIS-C"=0.15
        )
      )+
      theme_classic()+
      theme(
        panel.background=element_blank(),
        panel.grid=element_blank(),
        axis.line=element_line(color="black"),
        legend.position="right",
        legend.title=element_blank(),
        text=element_text(size=12)
      )+
      labs(
        x="UMAP 1",
        y="UMAP 2"
      )
    dev.off()
  })

}


# Fig. 4C: TNF expression across monocyte subsets.
fig4C <- function(sobj) {
  sobj <- prepare_myeloid(sobj)
  sobj <- subset(sobj, celltype %in% mono_types)
  run_panel({
    sobj$celltype <- factor(sobj$celltype, levels = mono_types)
    p <- VlnPlot(sobj, features = "TNF", group.by = "celltype", pt.size = 0, cols = subtypelist) + NoLegend()
    ggsave(file.path(out_dir, 'Fig4C_TNF_expression.pdf'), plot = p, width = 7, height = 4)
  })

}


# Fig. 4D: selected GO terms from the original marker enrichment table.
fig4D <- function(go_csv) {

  run_panel({
    df <- readr::read_csv(go_csv, show_col_types = FALSE)
    tnf_tracks <- df[grepl("tumor necrosis|TNF", df$Description, ignore.case = TRUE), ]
    il10_tracks <- df[grepl("interleukin-10|IL-10|IL10", df$Description, ignore.case = TRUE), ]
    df_select <- df[df$Description %in% c('response to type II interferon','myeloid leukocyte activation',
                                         'leukocyte cell-cell adhesion','regulation of inflammatory response','interleukin-10-mediated signaling pathway',
                                         'tumor necrosis factor production','response to tumor necrosis factor'),]
    df_top <- df_select %>%
      arrange(p.adjust) %>%
      dplyr::slice(1:10) %>%
      mutate(Description = fct_reorder(Description, -log10(p.adjust)))
    ggplot(df_top, aes(x = Description, y = -log10(p.adjust))) +
      geom_segment(aes(xend = Description, yend = 0), color = "gray70", size = 0.7) +
      geom_point(size =5.8,fill='#7fbbb2',color='#7fbbb2',stroke=0,show.legend = FALSE, alpha = 1) +
      geom_text(aes(label = Count), color = "white", size = 3) +
      coord_flip() +
      theme_minimal() +
      labs(title = "C1QC_Mono Upregulated Pathways",
           x = NULL,
           y = expression(-log[10](adj~P~value))) +
      theme(panel.grid.major.y = element_blank(),
            panel.grid.minor = element_blank(),
            panel.grid.major= element_blank(),
            axis.ticks = element_line(color = 'black'),
            axis.ticks.length = unit(2.5,'pt'),
            axis.line = element_line(colour = 'black'))
    ggsave(file.path(out_dir, 'Fig4D_C1QC_GO.pdf'),width = 6,height = 2.5)
  })

}


# Fig. 4E: sample/subset ROGUE scores; global Kruskal-Wallis test.
fig4E <- function(sobj) {
  sobj <- prepare_myeloid(sobj)
  run_panel({
    unique(sobj$celltype)
    sobj <- subset(sobj,celltype %in% c("Non-classical Mono","Classical Mono",
                                        "Mono_C1QC","Classical Mono_HLA-DR" ,
                                        "Classical Mono_NR4A2" ,"Classical Mono_IFN-response" ))
    sobj_sub <- sobj
    set.seed(2026)
    meta_sub <- sobj_sub@meta.data %>%
      rownames_to_column("cell_id") %>%
      filter(
        !is.na(Sample),
        !is.na(celltype),
        Sample != "",
        celltype != ""
      ) %>%
      mutate(
        Sample = as.character(Sample),
        celltype = as.character(celltype)
      ) %>%
      group_by(Sample, celltype) %>%
      filter(n() >= 20) %>%
      slice_sample(n = 300) %>%
      ungroup() %>%
      column_to_rownames("cell_id")
    table(meta_sub$Sample, meta_sub$celltype)
    counts_sub <- GetAssayData(
      sobj_sub,
      assay = "RNA",
      layer = "counts"
    )[, rownames(meta_sub), drop = FALSE]
    counts_sub <- counts_sub[
      Matrix::rowSums(counts_sub > 0) >= 3,
      ,
      drop = FALSE
    ]
    rogue_result <- ROGUE::rogue(
      expr = counts_sub,
      labels = meta_sub$celltype,
      samples = meta_sub$Sample,
      platform = "UMI",
      min.cell.n = 10,
      remove.outlier.n = 0
    )
    rogue_df <- rogue_result %>%
      as.data.frame() %>%
      rownames_to_column("Sample") %>%
      pivot_longer(
        cols = -Sample,
        names_to = "celltype",
        values_to = "ROGUE"
      ) %>%
      filter(!is.na(ROGUE))
    rogue_df %>%
      count(celltype, name = "n_samples") %>%
      arrange(n_samples)
    celltype_colors <- c(
      "Non-classical Mono" = "#F8CBA6",
      "pDC" = "#B7EA63",
      "cDC2" = "#d5c9db",
      "Classical Mono" = "#FADFA1",
      "Mono_C1QC" = "#0D747A",
      "Classical Mono_NR4A2" = "#DFF4F3",
      "Classical Mono_IFN-response" = "#46855E",
      "Classical Mono_HLA-DR" = "#b8bbe7",
      "Neutrophlis" = "#F99B36",
      "cDC1" = "#95D4FF"
    )
    plot_order <- names(celltype_colors)
    rogue_df <- rogue_df %>%
      filter(celltype %in% plot_order) %>%
      mutate(celltype = factor(celltype, levels = plot_order))
    rogue_df$celltype <- factor(
      rogue_df$celltype,
      levels = rogue_df %>%
        group_by(celltype) %>%
        summarise(median_ROGUE = median(ROGUE, na.rm = TRUE), .groups = "drop") %>%
        arrange(median_ROGUE) %>%
        pull(celltype)
    )
    ggplot(rogue_df,aes(x = celltype, y = ROGUE, fill = celltype,colour = celltype)) +
      geom_boxplot(width = 0.68,outlier.shape = NA,linewidth = 0.8,alpha =0.22) +
      geom_jitter(aes(color = celltype),width = 0.14,size = 1.5,alpha = 0.8,show.legend = FALSE) +
      scale_fill_manual(values = celltype_colors) +
      scale_color_manual(values = celltype_colors) +
      scale_y_continuous(
        expand = expansion(mult = c(0.02, 0.06))
      ) +
      labs(
        x = NULL,
        y = "ROGUE purity score"
      ) +
      theme_classic(base_size = 13) +
      stat_compare_means(method = 'kruskal.test', label = 'p.format') +
      theme(
        legend.position = "none",
        axis.text.x = element_text(
          angle = 45,
          hjust = 1,
          vjust = 1,
          color = "black"
        ),
        axis.text.y = element_text(color = "black"),
        axis.title.y = element_text(face = "bold"),
        axis.line = element_line(linewidth = 0.5)
      )
    ggsave(file.path(out_dir, 'Fig4E_ROGUE.pdf'),width = 4,height = 5)
  })

}


# Fig. 4F: CM/NCM signature coverage and enrichment in six pairwise DEG sets.
fig4F <- function(sobj) {
  sobj <- prepare_myeloid(sobj)
  run_panel({
    library(msigdbr)
    library(dplyr)
    library(UCell)
    c8 <- msigdbr(
      species = "Homo sapiens",
      collection = "C8"
    )
    CM_genes <- c8 %>%
      filter(gs_name == "TRAVAGLINI_LUNG_CLASSICAL_MONOCYTE_CELL") %>%
      pull(gene_symbol) %>%
      unique()
    NCM_genes <- c8 %>%
      filter(gs_name == "TRAVAGLINI_LUNG_NONCLASSICAL_MONOCYTE_CELL") %>%
      pull(gene_symbol) %>%
      unique()
    length(CM_genes)
    length(NCM_genes)
    CM_genes <- intersect(CM_genes, rownames(sobj))
    NCM_genes <- intersect(NCM_genes, rownames(sobj))
    length(CM_genes)
    length(NCM_genes)
    sig <- list(
      CM = CM_genes,
      NCM = NCM_genes
    )
    library(Seurat)
    library(dplyr)
    library(ggplot2)
    library(Matrix)
    cts <- c(
      "Classical Mono",
      "Non-classical Mono",
      "Mono_C1QC"
    )
    mono <- subset(sobj, subset = celltype %in% cts)
    Idents(mono) <- "celltype"
    CM_vs_NCM <- FindMarkers(
      mono,
      ident.1 = "Classical Mono",
      ident.2 = "Non-classical Mono",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    CM_vs_C1QC <- FindMarkers(
      mono,
      ident.1 = "Classical Mono",
      ident.2 = "Mono_C1QC",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    NCM_vs_CM <- FindMarkers(
      mono,
      ident.1 = "Non-classical Mono",
      ident.2 = "Classical Mono",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    NCM_vs_C1QC <- FindMarkers(
      mono,
      ident.1 = "Non-classical Mono",
      ident.2 = "Mono_C1QC",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    C1QC_vs_CM <- FindMarkers(
      mono,
      ident.1 = "Mono_C1QC",
      ident.2 = "Classical Mono",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    C1QC_vs_NCM <- FindMarkers(
      mono,
      ident.1 = "Mono_C1QC",
      ident.2 = "Non-classical Mono",
      only.pos = TRUE,
      min.pct = 0.1,
      logfc.threshold = 0.25
    )
    deg_list <- list(
      "CM > NCM"    = CM_vs_NCM,
      "CM > C1QC"   = CM_vs_C1QC,
      "NCM > CM"    = NCM_vs_CM,
      "NCM > C1QC"  = NCM_vs_C1QC,
      "C1QC > CM"   = C1QC_vs_CM,
      "C1QC > NCM"  = C1QC_vs_NCM
    )
    library(tibble)
    deg_list_sig <- lapply(deg_list, function(x) {
      x %>%
        rownames_to_column("gene") %>%
        filter(
          p_val_adj < 0.05,
          avg_log2FC > 0.25
        )
    })
    sapply(deg_list_sig, nrow)
    gene_sets <- list(CM_genes = CM_genes,NCM_genes = NCM_genes)
    plot_df <- bind_rows(
      lapply(names(deg_list_sig), function(deg_name) {
        deg <- deg_list_sig[[deg_name]]
        bind_rows(
          lapply(names(gene_sets), function(gs_name) {
            gs <- gene_sets[[gs_name]]
            overlap <- intersect(deg$gene, gs)
            hit_df <- deg %>%
              filter(gene %in% overlap)
            data.frame(
              DEG_group = deg_name,
              GeneSet = gs_name,
              n_DEG = nrow(deg),
              n_overlap = length(overlap),
              overlap_pct = length(overlap) / nrow(deg) * 100,
              mean_logFC = ifelse(
                length(overlap) > 0,
                mean(hit_df$avg_log2FC, na.rm = TRUE),
                NA
              )
            )
          })
        )
      })
    )
    library(Matrix)
    expr <- GetAssayData(mono, layer = "data")
    universe <- rownames(expr)[Matrix::rowSums(expr > 0) > 0]
    N_universe <- length(universe)
    N_universe
    CM_set  <- intersect(CM_genes, universe)
    NCM_set <- intersect(NCM_genes, universe)
    length(CM_set)
    length(NCM_set)
    gs_size <- c(
      CM_genes  = length(CM_set),
      NCM_genes = length(NCM_set)
    )
    plot_df2 <- plot_df %>%
      mutate(
        signature_coverage = case_when(
          GeneSet == "CM_genes"  ~ n_overlap / gs_size["CM_genes"]  * 100,
          GeneSet == "NCM_genes" ~ n_overlap / gs_size["NCM_genes"] * 100
        ),
        observed = n_overlap / n_DEG,
        expected = case_when(
          GeneSet == "CM_genes"  ~ gs_size["CM_genes"]  / N_universe,
          GeneSet == "NCM_genes" ~ gs_size["NCM_genes"] / N_universe
        ),
        enrichment = observed / expected,
        log2_enrichment = log2(enrichment)
      )
    plot_df2 %>%
      select(
        DEG_group,
        GeneSet,
        n_overlap,
        signature_coverage,
        enrichment,
        log2_enrichment,
        mean_logFC
      )
    library(ggplot2)
    library(dplyr)
    plot_df2 <- plot_df2 %>%
      mutate(
        Source = case_when(
          grepl("^CM >", DEG_group)   ~ "CM",
          grepl("^NCM >", DEG_group)  ~ "NCM",
          grepl("^C1QC >", DEG_group) ~ "C1QC"
        ),
        Comparison = case_when(
          DEG_group == "CM > NCM"    ~ "> NCM",
          DEG_group == "CM > C1QC"   ~ "> C1QC",
          DEG_group == "NCM > CM"    ~ "> CM",
          DEG_group == "NCM > C1QC"  ~ "> C1QC",
          DEG_group == "C1QC > CM"   ~ "> CM",
          DEG_group == "C1QC > NCM"  ~ "> NCM"
        )
      )
    plot_df2$Source <- factor(
      plot_df2$Source,
      levels = c("CM", "NCM", "C1QC")
    )
    plot_df2$GeneSet <- factor(
      plot_df2$GeneSet,
      levels = c("NCM_genes", "CM_genes")
    )
    plot_df2$Comparison <- factor(
      plot_df2$Comparison,
      levels = c("> NCM", "> CM", "> C1QC")
    )
    deg_for_c1qc_herter <- ggplot(
      plot_df2,
      aes(x = Comparison, y = GeneSet)
    ) +
      geom_point(
        aes(
          size = signature_coverage,
          fill = log2_enrichment
        ),
        shape = 21,
        color = "black",
        stroke = 0.7
      ) +
      facet_grid(
        . ~ Source,
        scales = "free_x",
        space = "free_x"
      ) +
      scale_size_area(
        max_size = 14,
        name = "Signature coverage (%)"
      ) +
      scale_fill_gradient2(
        low = "#8c9eba",
        mid = "#f3dbd6",
        high = "#d54846",
        midpoint = 3,
        name = expression(log[2]~enrichment)
      ) +
      labs(
        x = NULL,
        y = NULL
      ) +
      theme_classic() +
      theme(
        strip.background = element_blank(),
        strip.text = element_text(
          face = "bold",
          size = 11
        ),
        axis.text.x = element_text(
          angle = 45,
          hjust = 1,
          size = 9
        ),
        axis.text.y = element_text(
          size = 9
        ),
        legend.title = element_text(
          size = 8
        ),
        legend.text = element_text(
          size = 7
        ),
        legend.key.size = unit(0.35, "cm"),
        legend.spacing.y = unit(0.15, "cm"),
        panel.spacing.x = unit(1.2, "lines")
      ) +
      guides(
        size = guide_legend(
          title.position = "top",
          override.aes = list(
            shape = 21,
            color = "black",
            fill = "white",
            stroke = 0.5,
            alpha = 1
          )
        ),
        fill = guide_colorbar(
          title.position = "top",
          barwidth = unit(0.35, "cm"),
          barheight = unit(2.0, "cm")
        )
      )
    ggsave(file.path(out_dir, 'Fig4F_signature_enrichment.pdf'),plot = deg_for_c1qc_herter,width = 6,height = 2)
  })

}


# Fig. 4G: Monocle3 trajectory; original data-layer input and Classical Mono root retained.
fig4G <- function(sobj, expression_layer = "data") {
  sobj <- prepare_myeloid(sobj)
  sobj <- subset(sobj, celltype %in% mono_types)
  run_panel({
    library(Seurat)
    library(monocle3)
    library(ggplot2)
    mat <- GetAssayData(
      sobj,
      layer = expression_layer
    )
    cellInfo <- sobj@meta.data
    geneInfo <- data.frame(
      gene_short_name = rownames(mat),
      row.names = rownames(mat)
    )
    cds <- new_cell_data_set(
      expression_data = mat,
      cell_metadata = cellInfo,
      gene_metadata = geneInfo
    )
    cds <- preprocess_cds(
      cds,
      num_dim = 50
    )
    reducedDim(cds, "UMAP") <- Embeddings(
      sobj,
      "umap"
    )
    cds <- cluster_cells(
      cds,
      cluster_method = "louvain"
    )
    cds <- learn_graph(
      cds,
      use_partition = TRUE,
      verbose = TRUE,
      learn_graph_control = list(
        minimal_branch_len = 10
      )
    )
    start <- c("Classical Mono")
    closest_vertex <- cds@principal_graph_aux[["UMAP"]]$pr_graph_cell_proj_closest_vertex
    closest_vertex <- as.matrix(
      closest_vertex[colnames(cds), ]
    )
    root_pr_nodes <- igraph::V(
      principal_graph(cds)[["UMAP"]]
    )$name
    flag <- closest_vertex[
      as.character(colData(cds)$celltype) %in% start,
    ]
    flag <- as.numeric(
      names(which.max(table(flag)))
    )
    root_pr_nodes <- root_pr_nodes[flag]
    cds <- order_cells(
      cds,
      root_pr_nodes = root_pr_nodes
