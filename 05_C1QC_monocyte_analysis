# Supplementary Fig. 5C-D: selected C1QC DEGs and top-10 DEG ssGSEA scores.
# Supply a C1QC-only marker table in the original DEG ranking order.
sfig5CD <- function(series_matrix, platform_annotation, c1qc_markers, heatmap_genes) {
  stopifnot("gene" %in% colnames(c1qc_markers), length(heatmap_genes) > 0)
  signature_genes <- head(unique(as.character(c1qc_markers$gene)), 10)
  stopifnot(length(signature_genes) == 10, !anyNA(signature_genes))
  run_panel({
    data <- read.table(series_matrix,
                       header = TRUE,
                       sep = "\t",
                       quote = "\"",
                       fill = TRUE,
                       comment.char = "!",
                       row.names = 1,
                       check.names = FALSE)
    library(data.table)
    anno_clean <- fread(platform_annotation,
                        skip = "Array_Address_Id",
                        fill = TRUE,
                        sep = "\t")
    colnames(anno_clean)
    c1qc_probe <- anno_clean[anno_clean$ILMN_Gene == "C1QC", .(Probe_Id, ILMN_Gene)]
    print(c1qc_probe)
    library(GSVA)
    library(limma)
    library(ggplot2)
    anno_map <- anno_clean[, c("Probe_Id", "ILMN_Gene")]
    common_ids <- intersect(rownames(data), anno_map$Probe_Id)
    data_sub <- data[common_ids, ]
    data_sub$Symbol <- anno_map$ILMN_Gene[match(common_ids, anno_map$Probe_Id)]
    expr_only <- data_sub[, -ncol(data_sub)]
    genes_only <- data_sub$Symbol
    final_mat <- avereps(expr_only, ID = genes_only)
    dim(final_mat)
    "C1QC" %in% rownames(final_mat)
    all_header <- readLines(series_matrix, n = 100)
    gsm_line <- grep("^!Sample_geo_accession", all_header, value = TRUE)
    group_line <- grep("final condition", all_header, value = TRUE)
    gsm_ids <- strsplit(gsm_line, "\t")[[1]][-1]
    gsm_ids <- gsub("\"", "", gsm_ids)
    groups <- strsplit(group_line, "\t")[[1]][-1]
    groups <- gsub("\"", "", groups)
    groups <- gsub("status: ", "", groups)
    group_list <- groups
    names(group_list) <- gsm_ids
    group_raw <- as.character(group_list)
    names(group_raw) <- names(group_list)
    group_new <- rep(NA, length(group_raw))
    names(group_new) <- names(group_raw)
    group_new[group_raw == "final condition: healthy"] <- "Control"
    group_new[group_raw == "final condition: inKD"] <- "inKD"
    group_new[group_raw == "final condition: cKD"] <- "cKD"
    table(group_new, useNA = "ifany")
    keep_samples <- intersect(
      names(group_new)[!is.na(group_new)],
      colnames(final_mat)
    )
    final_mat_filtered <- final_mat[, keep_samples]
    group_final <- group_new[keep_samples]
    group_final <- factor(group_final, levels = c("Control", "inKD", "cKD"))
    all(colnames(final_mat_filtered) == names(group_final))
    table(group_final, useNA = "ifany")
    top_genes <- signature_genes
    final_mat_filtered[is.nan(final_mat_filtered)] <- NA
    final_mat_filtered <- t(apply(final_mat_filtered, 1, function(x) {
      x[is.na(x)] <- median(x, na.rm = TRUE)
      x
    }))
    final_mat_filtered <- as.matrix(final_mat_filtered)
    gene_set <- list(
      C1Q_nonclassical_monocyte = top_genes
    )
    param <- ssgseaParam(
      exprData = final_mat_filtered,
      geneSets = gene_set,
      alpha = 0.25,
      normalize = TRUE
    )
    ssgsea_score <- gsva(param)
    score_df <- data.frame(
      Sample = colnames(ssgsea_score),
      Score = as.numeric(ssgsea_score[1, ]),
      Group = group_final[colnames(ssgsea_score)]
    )
    table(score_df$Group, useNA = "ifany")
    head(score_df)
    score_df$Group <- factor(score_df$Group,levels = c("Control", "inKD", "cKD"))
    n_df <- score_df %>%count(Group)
    x_labs <- paste0(levels(score_df$Group),"\n(n = ",n_df$n[match(levels(score_df$Group), n_df$Group)],")")
    names(x_labs) <- levels(score_df$Group)
    my_comparisons <- list(c("Control", "inKD"),c("Control", "cKD"),c("inKD", "cKD"))
    p <- ggplot(score_df, aes(x = Group, y = Score, fill = Group, color = Group)) +
      geom_boxplot(width = 0.55,alpha = 0.28,outlier.shape = NA,linewidth = 0.9) +
      geom_jitter(width = 0.13,size = 2.2,alpha = 0.65,shape = 21,stroke = 0.8) +
      stat_compare_means(
        comparisons = my_comparisons,
        method = "wilcox.test",
        label = "p.format",
        tip.length = 0.01,
        bracket.size = 0.5,
        size = 4.2
      ) +
      scale_x_discrete(labels = x_labs) +
      scale_fill_manual(values = c("Control" = "#999999","inKD"= "#bfdfd2","cKD"= "#51999f")) +
      scale_color_manual(values = c("Control" = "#999999","inKD"= "#bfdfd2","cKD" = "#51999f")) +
      theme_classic() +
      theme(
        plot.title = element_text(hjust = 0.5, face = "bold", size = 17),
        axis.title.y = element_text(size = 15, face = "bold"),
        axis.text.x = element_text(size = 13, color = "black"),
        axis.text.y = element_text(size = 12, color = "black"),
        legend.position = "right",
        legend.title = element_text(face = "bold"),
        axis.line = element_line(linewidth = 0.8)
      ) +
      labs(
        x = "",
        y = "ssGSEA score",
        title = "C1QC+ monocyte signature in KD",
        fill = "Group",
        color = "Group"
      )
    pdf(file.path(out_dir, 'SFig5D_bulk_signature.pdf'),width = 4,height = 5)
    p + stat_summary(fun = median,geom = "line",aes(group = 1),linewidth = 0.8,linetype = "dashed",
                     color = "grey55"
      ) + stat_summary(fun = median,geom = "point",aes(group = 1),size = 2.8,color = "grey55")
    dev.off()
    group_factor <- factor(group_final, levels = c("Control", "inKD", "cKD"))
    sort_idx <- order(group_factor)
    valid_genes <- intersect(heatmap_genes, rownames(final_mat_filtered))
    stopifnot(length(valid_genes) > 0)
    plot_mat <- final_mat_filtered[valid_genes, sort_idx]
    plot_mat_scaled <- t(apply(plot_mat, 1, scale))
    colnames(plot_mat_scaled) <- colnames(plot_mat)
    rownames(plot_mat_scaled) <- rownames(plot_mat)
    plot_mat_scaled[plot_mat_scaled > 2] <- 2
    plot_mat_scaled[plot_mat_scaled < -2] <- -2
    library(ComplexHeatmap)
    library(circlize)
    col_fun = colorRamp2(c(-2, 0, 2), c("#2166ac", "white", "#b2182b"))
    ha = HeatmapAnnotation(
      Status = group_factor[sort_idx],
      col = list(Status = c("Control" = "#999999", "inKD" = "#bfdfd2", "cKD" = "#51999f")),
      simple_anno_size = unit(4, "mm"),
      show_annotation_name = FALSE
    )
    pdf(file.path(out_dir, 'SFig5C_bulk_expression.pdf'),width = 5,height = 3)
    ht = Heatmap(plot_mat_scaled,
                 name = "Z-score",
                 col = col_fun,
                 top_annotation = ha,
                 cluster_columns = FALSE,
                 column_split = group_factor[sort_idx],
                 column_title = NULL,
                 cluster_rows = T,
                 row_names_side = "right",
                 row_names_gp = gpar(fontsize = 10, fontface = "italic"),
                 show_column_names = FALSE,
                 border = NA,
                 rect_gp = gpar(col = "white", lwd = 0),
                 heatmap_legend_param = list(
                   title = "Z-score",
                   at = c(-2, 0, 2),
                   labels = c("-2", "0", "2")
                 )
    )
    print(ht)
    dev.off()
  })

}


# Supplementary Fig. 5F: mean raw AUCell activities per subset, row-scaled.
sfig5F <- function(sobj, loom_file) {
  sobj <- prepare_myeloid(sobj)
  run_panel({
    library(SCopeLoomR)
    library(AUCell)
    library(circlize)
    loom <- open_loom(loom_file)
    regulon_auc <- get_regulons_AUC(loom, column.attr.name = "RegulonsAUC")
    close_loom(loom)
    auc_mat <- getAUC(regulon_auc)
    features_to_plot <- c("STAT1(+)", "ETS2(+)", "JUN(+)", "KLF3(+)", "TCF7L2(+)", "IRF1(+)", "IRF7(+)", "KLF2(+)", "FOS(+)", "CEBPD(+)", "NFKB1(+)", "KLF4(+)")
    common_cells <- intersect(colnames(auc_mat), colnames(sobj))
    stopifnot(length(common_cells) > 0, all(features_to_plot %in% rownames(auc_mat)))
    labels <- sobj$celltype[match(common_cells, colnames(sobj))]
    groups <- c("Classical Mono", "Non-classical Mono", "Mono_C1QC")
    stopifnot(all(groups %in% labels))
    exp_mat <- sapply(groups, function(g) rowMeans(auc_mat[features_to_plot, common_cells[labels == g], drop = FALSE]))
    exp_mat_scaled <- t(scale(t(exp_mat)))
    pdf(file.path(out_dir, 'SFig5F_regulon_activity.pdf'), width = 3.85, height = 6)
    ht <- Heatmap(exp_mat_scaled, name = "Regulon activity (Z-score)",
      col = colorRamp2(c(-1, 0, 1), c("#eef3f8", "#9dabd0", "#424d95")),
      rect_gp = gpar(col = "white", lwd = 5), cluster_rows = FALSE, cluster_columns = FALSE)
    draw(ht)
    dev.off()
  })

}


