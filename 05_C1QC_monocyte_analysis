# Fig. 4K-L: corrected AUPR and target regulatory potential; provide final expressed-gene lists.
fig4KL <- function(c1qc_markers, expressed_genes_receiver, expressed_genes_sender, ligand_target_matrix, lr_network) {
  library(nichenetr)
  stopifnot(all(c("gene", "p_val_adj", "avg_log2FC") %in% colnames(c1qc_markers)))
  geneset <- c1qc_markers %>%
    filter(p_val_adj < 0.05, avg_log2FC > 0.5) %>%
    pull(gene) %>% unique()
  stopifnot(length(geneset) > 0)
  run_panel({
    geneset_oi <- geneset %>% .[. %in% rownames(ligand_target_matrix)]
    background_expressed_genes <- expressed_genes_receiver %>% .[. %in% rownames(ligand_target_matrix)]
    ligands = lr_network %>% pull(from) %>% unique()
    expressed_ligands = intersect(ligands,expressed_genes_sender)
    receptors = lr_network %>% pull(to) %>% unique()
    expressed_receptors = intersect(receptors,expressed_genes_receiver)
    lr_network_expressed = lr_network %>% filter(from %in% expressed_ligands & to %in% expressed_receptors)
    potential_ligands = lr_network_expressed %>% pull(from) %>% unique()
    ligand_activities = predict_ligand_activities(geneset = geneset_oi,
                                                  background_expressed_genes = background_expressed_genes,
                                                  ligand_target_matrix = ligand_target_matrix,
                                                  potential_ligands = potential_ligands)
    ligand_activities <- ligand_activities %>%
      arrange(-aupr_corrected) %>%
      mutate(rank = rank(dplyr::desc(aupr_corrected)))
    best_upstream_ligands <- ligand_activities %>%
      filter(auroc > 0,
             aupr > 0,
             aupr_corrected > 0,
             pearson > 0) %>%
      pull(test_ligand)
    best_upstream_ligands <- ligand_activities %>% top_n(10, aupr_corrected) %>% arrange(-aupr_corrected) %>% pull(test_ligand)
    p_hist_lig_activity <- ggplot(ligand_activities, aes(x=aupr_corrected)) +
      geom_histogram(color="black", fill="darkorange")  +
      geom_vline(aes(xintercept=min(ligand_activities %>% top_n(10, aupr_corrected) %>% pull(aupr_corrected))),
                 color="red", linetype="dashed", linewidth=1) +
      labs(x="Ligand activity (corrected AUPR)", y = "# ligands") + theme_classic()
    vis_ligand_aupr <- ligand_activities %>% dplyr::filter(test_ligand %in% best_upstream_ligands) %>%
      column_to_rownames("test_ligand") %>% dplyr::select(aupr_corrected) %>% arrange(aupr_corrected) %>% as.matrix()
    p_vis_ligand_aupr <- (make_heatmap_ggplot(vis_ligand_aupr,
                                              "Prioritized ligands", "Ligand activity",
                                              legend_title = "Corrected AUPR", color = "#639494") +
                            theme(
                              axis.text.x.top = element_blank()
                            )) +
      guides(fill = guide_colorbar(barwidth = 10, barheight = 0.75))
    ggsave(file.path(out_dir, 'Fig4K_ligand_activity.pdf'),plot = p_vis_ligand_aupr, width = 1.7,height = 8)
    ggsave(file.path(out_dir, 'bestligands_10_bar.pdf'),plot = p_vis_ligand_aupr, width = 4,height = 8)
    library(dplyr)
    active_ligand_target_links_df = best_upstream_ligands %>% lapply(get_weighted_ligand_target_links,geneset = geneset_oi, ligand_target_matrix = ligand_target_matrix, n = 2500) %>% bind_rows()
    active_ligand_target_links_df <- na.omit(active_ligand_target_links_df)
    active_ligand_target_links = prepare_ligand_target_visualization(ligand_target_df = active_ligand_target_links_df, ligand_target_matrix = ligand_target_matrix, cutoff = 0.30)
    order_ligands = intersect(best_upstream_ligands, colnames(active_ligand_target_links)) %>% rev()
    order_targets = active_ligand_target_links_df$target %>% unique()
    order_targets <- intersect(order_targets, rownames(active_ligand_target_links))
    order_ligands <- intersect(order_ligands, colnames(active_ligand_target_links))
    vis_ligand_target = active_ligand_target_links[order_targets,order_ligands] %>% t()
    target_total_weight <- rowSums(active_ligand_target_links)
    order_targets_top60 <- names(sort(target_total_weight, decreasing = TRUE))[seq_len(min(60, nrow(active_ligand_target_links)))]
    vis_ligand_target_top60 <- active_ligand_target_links[order_targets_top60, order_ligands] %>% t()
    all(colnames(vis_ligand_target_top60) == order_targets_top60)
    p_ligand_target_network <- vis_ligand_target_top60 %>%
      make_heatmap_ggplot("Prioritized ligands","Shared genes",
                          color = "#608297",
                          legend_position = "bottom",
                          x_axis_position = "top",
                          legend_title = "Regulatory potential") +
      scale_fill_gradient2(low = "whitesmoke",
                           high = "#608297") +
      scale_y_discrete(limits=rownames(vis_ligand_target))+
      theme(axis.text.x = element_text(face = "italic"))
    ggsave(file.path(out_dir, 'Fig4L_ligand_target.pdf'),
           p_ligand_target_network,
           width=9.48,
           height=3.45,
           dpi = 3000,
           units = 'in')
  })

}


