# Supplementary Fig. 6B: module-member abundance correlations across non-Healthy samples.
# Source nmf_cm.r uses Pearson and top 8 W-ranked subsets (membership may overlap).
# Set method = "spearman" for the manuscript legend, or members = "exclusive" for unique modules.
plot_module_networks <- function(prepared, W_mat, out_dir = "fig5_nmf",
                                method = "pearson", members = "top8",
                                threshold = 0.4, positive_only = TRUE) {
  method <- match.arg(method, c("pearson", "spearman"))
  members <- match.arg(members, c("top8", "exclusive"))
  dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
  patient_samples <- prepared$sample_info$Sample[prepared$sample_info$majordisease != "Healthy"]
  patient_samples <- intersect(patient_samples, colnames(prepared$nmf_input))
  stopifnot(length(patient_samples) >= 3)
  X <- prepared$nmf_input[rownames(W_mat), patient_samples, drop = FALSE]
  variable_cells <- apply(X, 1, sd) > 0
  correlation <- cor(t(X[variable_cells, , drop = FALSE]), method = method)
  assignments <- max.col(W_mat, ties.method = "first")
  groups <- lapply(seq_len(ncol(W_mat)), function(k) {
    if (members == "top8") rownames(W_mat)[head(order(W_mat[, k], decreasing = TRUE), 8)] else
      rownames(W_mat)[assignments == k]
  })
  names(groups) <- colnames(W_mat)
  lin <- prepared$cell_info$majorcluster[match(rownames(W_mat), prepared$cell_info$celltype)]
  names(lin) <- rownames(W_mat)
  lineage_colors <- setNames(scales::hue_pal()(length(unique(lin))), sort(unique(lin)))
  edges_export <- list()
  set.seed(2026)
  pdf(file.path(out_dir, "SFig6B_module_correlations.pdf"), width = 10, height = 8)
  oldpar <- par(mfrow = c(2, 2), mar = c(1, 1, 3, 1))
  for (k in seq_along(groups)) {
    nodes <- intersect(groups[[k]], rownames(correlation))
    if (length(nodes) < 2) {
      plot.new(); title(paste(names(groups)[k], "fewer than 2 variable subsets")); next
    }
    R <- correlation[nodes, nodes, drop = FALSE]
    keep <- upper.tri(R) & (if (positive_only) R > threshold else abs(R) > threshold)
    ij <- which(keep, arr.ind = TRUE)
    edges <- data.frame(from = rownames(R)[ij[, 1]], to = colnames(R)[ij[, 2]],
                        weight = R[ij], Module = rep(names(groups)[k], nrow(ij)))
    edges_export[[k]] <- edges
    g <- igraph::graph_from_data_frame(edges[, c("from", "to", "weight")],
                                       directed = FALSE, vertices = data.frame(name = nodes))
    g <- igraph::delete_vertices(g, igraph::V(g)[igraph::degree(g) == 0])
    if (!igraph::vcount(g)) {
      plot.new(); title(paste(names(groups)[k], "no edges above threshold")); next
    }
    w <- igraph::E(g)$weight
    gray <- gray.colors(100, start = 0.85, end = 0.25)
    color_idx <- pmax(1, pmin(100, ceiling(abs(w) * 100)))
    plot(g, layout = igraph::layout_in_circle(g),
         vertex.color = unname(lineage_colors[lin[igraph::V(g)$name]]),
         vertex.size = 8, vertex.label.cex = 0.55, vertex.label.color = "black",
         edge.width = 1 + abs(w) * 3, edge.color = gray[color_idx],
         edge.lty = ifelse(w < 0, 2, 1), main = names(groups)[k])
  }
  par(oldpar); dev.off()
  write.csv(bind_rows(edges_export), file.path(out_dir, "module_correlation_edges.csv"), row.names = FALSE)
  write.csv(stack(groups), file.path(out_dir, "network_module_members.csv"), row.names = FALSE)
  write.csv(data.frame(Lineage = names(lineage_colors), Color = unname(lineage_colors)),
            file.path(out_dir, "network_lineage_colors.csv"), row.names = FALSE)
  writeLines(c(paste("Correlation:", method), paste("Membership:", members),
               paste("Threshold:", threshold), paste("Positive edges only:", positive_only),
               paste("Non-Healthy samples:", length(patient_samples))),
             file.path(out_dir, "network_settings.txt"))
  invisible(list(correlation = correlation, members = groups, edges = bind_rows(edges_export)))
}


